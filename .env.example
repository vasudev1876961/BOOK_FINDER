# =========================================================================
# AETHERIA - Enterprise AI Book Discovery Platform Configuration Template
# =========================================================================

# Project Name
PROJECT_NAME="Aetheria | AI Book Discovery Platform"

# API prefix string
API_V1_STR="/api/v1"

# JWT Security Configurations
# Change this secret key in production! Run `openssl rand -hex 32` to generate a secure one.
SECRET_KEY="super-secret-key-change-in-production-aetheria-discovery"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Relational Database Selection
# Local Dev Default: SQLite
DATABASE_URL="sqlite:///./book_finder.db"
# Production Example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/book_finder"

# Vector Database configurations
CHROMA_PERSIST_DIRECTORY="./chroma_db"

# AI/LLM Provider configuration
# Options: "mock" (default, zero setup needed), "openai", or "ollama"
LLM_PROVIDER="mock"

# OpenAI settings (Required if LLM_PROVIDER="openai")
OPENAI_API_KEY=""

# Ollama local settings (Required if LLM_PROVIDER="ollama")
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Local Embedding settings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
